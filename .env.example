# ---------------------------------------------------------------------------
# Multimodal RAG Assistant - environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
MRAG_LOG_LEVEL=INFO
# "auto" picks CUDA if available, otherwise CPU. Override with "cpu" or "cuda".
MRAG_DEVICE=auto
# If a neural backend cannot be loaded, fall back to the documented offline
# backend (hashing / metadata / extractive) and show a warning instead of failing.
MRAG_FALLBACK_ON_ERROR=true
# Where Hugging Face weights are cached (optional; defaults to HF cache).
# HF_HOME=./models_cache

# --- Paths -----------------------------------------------------------------
MRAG_DATA_DIR=./data
MRAG_INDEX_DIR=./data/index

# --- Embeddings ------------------------------------------------------------
# Backend: "sentence_transformers" (real dense model) or "hashing" (offline
# lexical fallback: deterministic hashed n-gram vectors, no neural model).
MRAG_EMBEDDING_BACKEND=sentence_transformers
MRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only used by the hashing backend.
MRAG_EMBEDDING_DIM=384

# --- Speech (Whisper) ------------------------------------------------------
# Backend: "transformers" (Hugging Face Whisper) or "none" (audio disabled).
MRAG_WHISPER_BACKEND=transformers
MRAG_WHISPER_MODEL=openai/whisper-small
# Force a language code (e.g. "en") or leave empty for auto-detection.
MRAG_WHISPER_LANGUAGE=

# --- Vision (Qwen-VL) ------------------------------------------------------
# Backend: "transformers" (local Qwen2-VL / Qwen2.5-VL via Hugging Face),
#          "openai_compatible" (any OpenAI-style /chat/completions endpoint that
#          serves a vision model: vLLM, Ollama, DashScope, ...),
#          or "metadata" (offline fallback: image metadata only, no VLM).
MRAG_VISION_BACKEND=transformers
MRAG_VISION_MODEL=Qwen/Qwen2-VL-2B-Instruct
MRAG_VISION_MAX_NEW_TOKENS=512

# --- Answer generation (LLM) ----------------------------------------------
# Backend: "transformers" (reuse the local Qwen-VL model for text generation),
#          "openai_compatible" (OpenAI-style endpoint),
#          or "extractive" (offline fallback: evidence-only extractive answer,
#          no language model - clearly labelled in the UI).
MRAG_LLM_BACKEND=transformers
MRAG_LLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
MRAG_LLM_MAX_NEW_TOKENS=512
MRAG_LLM_TEMPERATURE=0.2

# --- OpenAI-compatible endpoint (used by vision/LLM "openai_compatible") ---
MRAG_OPENAI_BASE_URL=http://localhost:8000/v1
MRAG_OPENAI_API_KEY=
MRAG_OPENAI_TIMEOUT_S=120

# --- Retrieval -------------------------------------------------------------
MRAG_CHUNK_SIZE=400
MRAG_CHUNK_OVERLAP=80
MRAG_TOP_K=5
# Cosine similarity threshold in [-1, 1]; chunks below it are dropped.
MRAG_SIMILARITY_THRESHOLD=0.25
MRAG_RERANK=false
MRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- API server ------------------------------------------------------------
MRAG_API_HOST=0.0.0.0
MRAG_API_PORT=8080
