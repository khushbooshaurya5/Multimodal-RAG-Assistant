# Air-gapped / CI profile: no model downloads. No neural model is used.
MRAG_LOG_LEVEL=INFO
MRAG_DEVICE=cpu
MRAG_EMBEDDING_BACKEND=hashing
MRAG_EMBEDDING_DIM=384
MRAG_WHISPER_BACKEND=none
MRAG_VISION_BACKEND=metadata
MRAG_LLM_BACKEND=extractive
MRAG_TOP_K=5
# Hashed lexical vectors produce lower cosine scores than dense embeddings; 0.15 was
# chosen from the threshold sweep in docs/EVALUATION.md.
MRAG_SIMILARITY_THRESHOLD=0.15
