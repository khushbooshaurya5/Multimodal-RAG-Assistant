MRAG_LOG_LEVEL=INFO
MRAG_DEVICE=auto
MRAG_EMBEDDING_BACKEND=sentence_transformers
MRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MRAG_WHISPER_BACKEND=transformers
MRAG_WHISPER_MODEL=openai/whisper-small
MRAG_VISION_BACKEND=transformers
MRAG_VISION_MODEL=Qwen/Qwen2-VL-2B-Instruct
MRAG_LLM_BACKEND=transformers
MRAG_LLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
MRAG_TOP_K=5
MRAG_SIMILARITY_THRESHOLD=0.25
MRAG_RERANK=false
