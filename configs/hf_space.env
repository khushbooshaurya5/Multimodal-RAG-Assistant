# Profile for the Hugging Face Space (free CPU tier: 2 vCPU, 16 GB RAM).
# Small models so the Space stays within memory; expect tens of seconds per answer.
MRAG_LOG_LEVEL=INFO
MRAG_DEVICE=cpu
MRAG_FALLBACK_ON_ERROR=true
MRAG_EMBEDDING_BACKEND=sentence_transformers
MRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MRAG_WHISPER_BACKEND=transformers
MRAG_WHISPER_MODEL=openai/whisper-base
MRAG_VISION_BACKEND=transformers
MRAG_VISION_MODEL=Qwen/Qwen2-VL-2B-Instruct
MRAG_VISION_MAX_NEW_TOKENS=256
MRAG_LLM_BACKEND=transformers
MRAG_LLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
MRAG_LLM_MAX_NEW_TOKENS=256
MRAG_TOP_K=5
MRAG_SIMILARITY_THRESHOLD=0.25
MRAG_RERANK=false
# Spaces have an ephemeral filesystem; the index lives under /tmp and resets on restart.
MRAG_DATA_DIR=/tmp/mrag-data
MRAG_INDEX_DIR=/tmp/mrag-data/index
